    _ = pow6Matrix * pow1Matrix := by rw [casimir_pow_6, casimir_is_computed_weight_matrix]
    _ = pow7Matrix := table_mul_7

private theorem annihilator_expanded :
    (casimir - scalar 0) * (casimir - scalar 2) *
    (casimir - scalar 6) * (casimir - scalar 12) *
    (casimir - scalar 20) * (casimir - scalar 30) *
    (casimir - scalar 42) =
    casimir ^ 7 - (112 : ℤ) • casimir ^ 6 +
    (4648 : ℤ) • casimir ^ 5 - (89280 : ℤ) • casimir ^ 4 +
    (808848 : ℤ) • casimir ^ 3 - (3110400 : ℤ) • casimir ^ 2 +
    (3628800 : ℤ) • casimir := by
  simp only [scalar]
  noncomm_ring

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
theorem casimir_annihilator :
    (casimir - scalar 0) * (casimir - scalar 2) *
    (casimir - scalar 6) * (casimir - scalar 12) *
    (casimir - scalar 20) * (casimir - scalar 30) *
    (casimir - scalar 42) = 0 := by
  rw [annihilator_expanded, casimir_pow_7, casimir_pow_6,
      casimir_pow_5, casimir_pow_4, casimir_pow_3, casimir_pow_2,
      casimir_is_computed_weight_matrix]
  native_decide

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
private theorem projector_eq_table : projectorNumerator = projectorMatrix := by
  calc
    projectorNumerator =
      casimir ^ 6 - (107 : ℤ) • casimir ^ 5 +
      (4088 : ℤ) • casimir ^ 4 - (66940 : ℤ) • casimir ^ 3 +
      (430848 : ℤ) • casimir ^ 2 - (624960 : ℤ) • casimir := by
        simp only [projectorNumerator, selector, scalar]
        noncomm_ring
    _ = projectorMatrix := by
      rw [casimir_pow_6, casimir_pow_5, casimir_pow_4,
          casimir_pow_3, casimir_pow_2, casimir_is_computed_weight_matrix]
      native_decide

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
private theorem kernel_eq_table : kernelOperator = kernelMatrix := by
  calc
    kernelOperator = casimir ^ 2 - (36 : ℤ) • casimir + scalar 180 := by
      simp only [kernelOperator, scalar]
      noncomm_ring
    _ = kernelMatrix := by
      rw [casimir_pow_2, casimir_is_computed_weight_matrix]
      native_decide

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
private theorem bezout_eq_table :
    bezoutQuotient casimir = bezoutMatrix := by
  calc
    bezoutQuotient casimir =
      -(casimir ^ 4) + (71 : ℤ) • casimir ^ 3 -
      (1352 : ℤ) • casimir ^ 2 +
      (5488 : ℤ) • casimir + scalar 10080 := by
        simp only [bezoutQuotient, scalar]
        noncomm_ring
    _ = bezoutMatrix := by
      rw [casimir_pow_4, casimir_pow_3, casimir_pow_2,
          casimir_is_computed_weight_matrix]
      native_decide

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
theorem scaled_projector_is_idempotent :
    projectorNumerator * projectorNumerator =
      (1814400 : ℤ) • projectorNumerator := by
  rw [projector_eq_table]
  native_decide

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
theorem selected_subspace_is_kernel :
    kernelOperator * projectorNumerator = 0 := by
  rw [kernel_eq_table, projector_eq_table]
  native_decide

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
theorem scaled_projector_trace :
    Matrix.trace projectorNumerator = (47 : ℤ) * 1814400 := by
  rw [projector_eq_table]
  native_decide

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
theorem kernel_bezout :
    projectorNumerator +
      kernelOperator * bezoutQuotient casimir = scalar 1814400 := by
  rw [projector_eq_table, kernel_eq_table, bezout_eq_table]
  native_decide

