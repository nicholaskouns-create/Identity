set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
theorem casimir_is_computed_weight_matrix : casimir = pow1Matrix := by
  native_decide

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
private theorem table_mul_2 : pow1Matrix * pow1Matrix = pow2Matrix := by
  native_decide

set_option maxRecDepth 50000 in
private theorem casimir_pow_2 : casimir ^ 2 = pow2Matrix := by
  calc
    casimir ^ 2 = casimir * casimir := by noncomm_ring
    _ = pow1Matrix * pow1Matrix := by rw [casimir_is_computed_weight_matrix]
    _ = pow2Matrix := table_mul_2


set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
private theorem table_mul_3 : pow2Matrix * pow1Matrix = pow3Matrix := by
  native_decide

set_option maxRecDepth 50000 in
private theorem casimir_pow_3 : casimir ^ 3 = pow3Matrix := by
  calc
    casimir ^ 3 = casimir ^ 2 * casimir := by noncomm_ring
    _ = pow2Matrix * pow1Matrix := by rw [casimir_pow_2, casimir_is_computed_weight_matrix]
    _ = pow3Matrix := table_mul_3


